{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentsuite.io/contracts/annual-only-public-served-attestation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "predicateType", "privateSha", "publicSha", "privateAdmissionDigest", "billingImageDigest", "disclosureDigest", "privateDeploymentRun", "publicDeploymentRun", "publicArtifact", "clientServedAt", "verifiedAt", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 }, "predicateType": { "const": "https://silentsuite.io/attestations/annual-only-public-served/v1" },
    "privateSha": { "$ref": "#/$defs/sha" }, "publicSha": { "$ref": "#/$defs/sha" }, "privateAdmissionDigest": { "$ref": "#/$defs/digest" }, "billingImageDigest": { "$ref": "#/$defs/digest" }, "disclosureDigest": { "$ref": "#/$defs/digest" },
    "privateDeploymentRun": { "$ref": "#/$defs/run" }, "publicDeploymentRun": { "$ref": "#/$defs/run" }, "publicArtifact": { "$ref": "#/$defs/artifact" }, "clientServedAt": { "$ref": "#/$defs/time" }, "verifiedAt": { "$ref": "#/$defs/time" }, "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "run": { "type": "object", "additionalProperties": false, "required": ["runId", "runAttempt"], "properties": { "runId": { "type": "integer", "minimum": 1 }, "runAttempt": { "type": "integer", "minimum": 1 } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["repository", "runId", "runAttempt", "artifactId"], "properties": { "repository": { "type": "string", "pattern": "^silent-suite/[a-z0-9._-]+$" }, "runId": { "type": "integer", "minimum": 1 }, "runAttempt": { "type": "integer", "minimum": 1 }, "artifactId": { "type": "integer", "minimum": 1 } } }
  }
}
