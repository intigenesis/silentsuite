{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://silentsuite.io/contracts/annual-only-pre-public-admission.schema.json",
  "description": "Stage A (private pre-public admission) v2. `privateSha` is the exact private main head of the run that produced this admission and is never a deployment claim; `deployedRuntime` is the live Billing runtime identity observed twice through the authenticated runtime-identity endpoint of the exact production origin: `privateSha` (the deployed private SHA, which may differ from the top-level `privateSha`) and `imageDigest` are what the live runtime reports, `deployedAt` is the runtime-reported start time, `observedAt` is the first authenticated observation before any admission input was consumed, and `reobservedAt` is the second authenticated observation immediately before signing, every identity member of which equalled the first. Stage A is pre-public admission only and carries no public-service claim.",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "predicateType", "privateSha", "expectedPublicSha", "billingImageDigest", "rollbackImageDigest", "buildAttestationDigest", "qaAttestationDigest", "providerRegistryDigest", "providerAdmission", "disclosureDigest", "producerRun", "deployedRuntime", "publicReview", "signature"],
  "properties": {
    "schemaVersion": { "const": 2 }, "predicateType": { "const": "https://silentsuite.io/attestations/annual-only-pre-public-admission/v2" },
    "privateSha": { "$ref": "#/$defs/sha", "description": "Producer source identity: the private main head of the run that produced and uploaded this admission." },
    "expectedPublicSha": { "$ref": "#/$defs/sha" },
    "billingImageDigest": { "$ref": "#/$defs/digest", "description": "The admitted annual image digest; must equal deployedRuntime.imageDigest." },
    "rollbackImageDigest": { "$ref": "#/$defs/digest" }, "buildAttestationDigest": { "$ref": "#/$defs/digest" }, "qaAttestationDigest": { "$ref": "#/$defs/digest" }, "providerRegistryDigest": { "$ref": "#/$defs/digest" },
    "providerAdmission": { "$ref": "#/$defs/providerAdmission", "description": "The deploy.yml run and artifact that admitted deployedRuntime; equals producerRun only when the producer was that additive deployment run." },
    "disclosureDigest": { "$ref": "#/$defs/digest" },
    "producerRun": { "$ref": "#/$defs/run", "description": "The exact deploy.yml or annual-only-stage-a-reattest.yml run that produced this admission." },
    "deployedRuntime": { "$ref": "#/$defs/deployedRuntime" },
    "publicReview": { "$ref": "#/$defs/review" }, "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, "signature": { "type": "string", "pattern": "^[0-9a-f]{64}$" }, "time": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "run": { "type": "object", "additionalProperties": false, "required": ["runId", "runAttempt"], "properties": { "runId": { "type": "integer", "minimum": 1 }, "runAttempt": { "type": "integer", "minimum": 1 } } },
    "providerAdmission": { "type": "object", "additionalProperties": false, "required": ["artifactId", "archiveDigest", "statementDigest", "runId", "runAttempt"], "properties": { "artifactId": { "type": "integer", "minimum": 1 }, "archiveDigest": { "$ref": "#/$defs/digest" }, "statementDigest": { "$ref": "#/$defs/digest" }, "runId": { "type": "integer", "minimum": 1 }, "runAttempt": { "type": "integer", "minimum": 1 } } },
    "deployedRuntime": { "type": "object", "additionalProperties": false, "required": ["privateSha", "imageDigest", "phase", "deployedAt", "observedAt", "reobservedAt"], "properties": { "privateSha": { "$ref": "#/$defs/sha" }, "imageDigest": { "$ref": "#/$defs/digest" }, "phase": { "const": "additive" }, "deployedAt": { "$ref": "#/$defs/time" }, "observedAt": { "$ref": "#/$defs/time" }, "reobservedAt": { "$ref": "#/$defs/time" } } },
    "review": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "predicateType", "repository", "publicSha", "runId", "runAttempt", "disclosureDigest", "signature"], "properties": { "schemaVersion": { "const": 2 }, "predicateType": { "const": "https://silentsuite.io/attestations/annual-only-public-review/v2" }, "repository": { "const": "silent-suite/silentsuite" }, "publicSha": { "$ref": "#/$defs/sha" }, "runId": { "type": "integer", "minimum": 1 }, "runAttempt": { "type": "integer", "minimum": 1 }, "disclosureDigest": { "$ref": "#/$defs/digest" }, "signature": { "$ref": "#/$defs/signature" } } }
  }
}
